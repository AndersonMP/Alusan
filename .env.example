# Copiar a .env (local) o pegar en Coolify / Render → Environment
# Renombrar: cp .env.example .env

PORT=3001
NODE_ENV=production

PERSEO_API_KEY=tu_api_key_perseo
API_KEY=tu_api_key_perseo
API_BASE_URL=https://accesoalnusan.app/api
ALMACEN_ID=2

CACHE_TTL_CATEGORIAS=21600
CACHE_TTL_PRODUCTOS=14400
CACHE_TTL_EXISTENCIAS=120
CACHE_CONTROL_PRODUCTOS=60

# true = siempre incluir imágenes (1 por variante por defecto); false si solo se requiere catálogo y stock
DEFAULT_INCLUIR_IMAGENES=false
DEFAULT_MAX_IMAGENES=1
DEFAULT_TARIFAS_RESUMIDAS=true

CACHE_MAX_CATALOG_KEYS=200
CACHE_MAX_IMAGENES_KEYS=10000
CACHE_MAX_EXISTENCIAS_KEYS=25000

MAX_IMAGE_SIZE=800
IMAGE_QUALITY=75
COMPRESSION_EFFORT=4
MAX_OUTPUT_BYTES=150000
IMAGE_EMERGENCY_SIZE=400
IMAGE_EMERGENCY_QUALITY=60
MAX_IMAGE_RESPONSE_BYTES=5242880

MAX_CONCURRENT_REQUESTS=4
MAX_CONCURRENT_COMPRESSION=2
MAX_CONCURRENT_EXISTENCIAS=15
HIDRATACION_BATCH_SIZE=4
EXISTENCIAS_BATCH_SIZE=30
COMPRESSION_BATCH_SIZE=2

EXISTENCIAS_REQUEST_TIMEOUT=5000
IMAGE_REQUEST_TIMEOUT=10000
PRODUCTOS_CONSULTA_TIMEOUT=60000

LOG_VERBOSE=false
